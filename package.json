{
  "name": "@yuyaxiong/dsh-usage-report",
  "version": "0.2.0",
  "description": "Token usage and cost dashboard for DeepSeek Harness: charts by hour and day, per-model panels, and a per-purpose split that separates conversation from auto review.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "usage",
    "tokens",
    "cost",
    "dashboard",
    "auto-review",
    "purpose"
  ],
  "author": "yuyaxiong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyaxiong/dsh-usage-report.git"
  },
  "homepage": "https://github.com/yuyaxiong/dsh-usage-report",
  "engines": {
    "dsh": "^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "index": "node scripts/make-index.mjs --repo https://github.com/yuyaxiong/dsh-usage-report"
  }
}
